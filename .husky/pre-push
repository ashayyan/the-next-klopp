# Local fallback for branch protection: block direct pushes to main (override once: ALLOW_MAIN_PUSH=1).
# Skippable with --no-verify; the CI guards job is the non-bypassable copy.
while read -r local_ref local_sha remote_ref remote_sha; do
  if [ "$remote_ref" = "refs/heads/main" ] && [ -z "$ALLOW_MAIN_PUSH" ]; then
    echo "pre-push: direct push to main is blocked. Push a gsd/phase-* branch and open a PR. Override once: ALLOW_MAIN_PUSH=1" >&2
    exit 1
  fi
done
exit 0
