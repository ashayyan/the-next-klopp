  "font": {
    "display": {
      "$type": "fontFamily",
      "$value": ["Newsreader", "ui-serif", "Georgia", "serif"],
      "$extensions": {
        "tnk": {
          "licence": "OFL-1.1",
          "files": [
            {
              "src": "/fonts/newsreader/newsreader-latin-opsz-normal.woff2",
              "weight": "200 800",
              "style": "normal"
            }
          ]
        }
      }
    },
    "sans": {
      "$type": "fontFamily",
      "$value": ["Atkinson Hyperlegible Next", "ui-sans-serif", "system-ui", "sans-serif"],
      "$extensions": {
        "tnk": {
          "licence": "OFL-1.1",
          "files": [
            {
              "src": "/fonts/atkinson-hyperlegible-next/atkinson-hyperlegible-next-latin-wght-normal.woff2",
              "weight": "200 800",
              "style": "normal"
            }
          ]
        }
      }
    },
    "mono": {
      "$type": "fontFamily",
      "$value": ["Atkinson Hyperlegible Mono", "ui-monospace", "Consolas", "monospace"],
      "$extensions": {
        "tnk": {
          "licence": "OFL-1.1",
          "files": [
            {
              "src": "/fonts/atkinson-hyperlegible-mono/atkinson-hyperlegible-mono-latin-wght-normal.woff2",
              "weight": "200 800",
              "style": "normal"
            }
          ]
        }
      }
    }
  },
  "text": {
    "label": {
      "$type": "typography",
      "$value": {
        "fontFamily": "{font.sans}",
        "fontSize": {
