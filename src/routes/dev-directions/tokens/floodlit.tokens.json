  },
  "duration": {
    "ui": {
      "$type": "duration",
      "$value": {
        "value": 160,
        "unit": "ms"
      }
    },
    "draw": {
      "$type": "duration",
      "$value": {
        "value": 240,
        "unit": "ms"
      }
    },
    "morph": {
      "$type": "duration",
      "$value": {
        "value": 640,
        "unit": "ms"
      }
    },
    "stagger-line": {
      "$type": "duration",
      "$value": {
        "value": 60,
        "unit": "ms"
      }
    }
  },
  "easing": {
    "ui": {
      "$type": "cubicBezier",
      "$value": [0.2, 0, 0, 1]
    },
    "morph": {
      "$type": "cubicBezier",
      "$value": [0.65, 0, 0.35, 1]
    }
  },
  "icon": {
    "stroke": {
      "$type": "dimension",
      "$value": {
        "value": 1.5,
        "unit": "px"
      },
      "$extensions": {
        "tnk": {
          "linecap": "square"
        }
      }
    }
  }
