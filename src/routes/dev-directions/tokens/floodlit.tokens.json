  "font": {
    "display": {
      "$type": "fontFamily",
      "$value": ["Mona Sans", "ui-sans-serif", "system-ui", "sans-serif"],
      "$extensions": {
        "tnk": {
          "stretch": "125%",
          "licence": "OFL-1.1",
          "files": [
            {
              "src": "/fonts/mona-sans/mona-sans-latin-wdth-normal.woff2",
              "weight": "200 900",
              "stretch": "75% 125%",
              "style": "normal"
            }
          ]
        }
      }
    },
    "sans": {
      "$type": "fontFamily",
      "$value": ["Mona Sans", "ui-sans-serif", "system-ui", "sans-serif"]
    },
    "mono": {
      "$type": "fontFamily",
      "$value": ["Geist Mono", "ui-monospace", "Consolas", "monospace"],
      "$extensions": {
        "tnk": {
          "licence": "OFL-1.1",
          "files": [
            {
              "src": "/fonts/geist-mono/geist-mono-latin-wght-normal.woff2",
              "weight": "100 900",
              "style": "normal"
            }
          ]
        }
      }
    }
  },
