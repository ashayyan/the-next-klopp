          "stretch": "75%",
          "licence": "OFL-1.1",
          "files": [
            {
              "src": "/fonts/archivo/archivo-latin-wdth-normal.woff2",
              "weight": "100 900",
              "stretch": "62% 125%",
              "style": "normal"
            }
          ]
        }
      }
    },
