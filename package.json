{
  "name": "the-next-klopp",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "vite",
    "study": "vite build && vite preview",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "format": "biome check --write .",
    "test": "vitest run",
    "guard": "node scripts/guard-files.ts --tracked",
    "guard:bundle": "node scripts/check-bundle.ts",
    "guard:immutable": "node scripts/check-immutable.ts --base origin/main",
    "validate:schemas": "vitest run schemas",
    "data": "uv run --locked --project pipeline klopp-pipeline run-all",
    "data:fetch": "uv run --locked --project pipeline klopp-pipeline fetch --all",
    "data:coverage": "uv run --locked --project pipeline klopp-pipeline coverage",
    "pipeline:test": "uv run --locked --project pipeline pytest pipeline/tests -q",
    "research:check": "vitest run scripts/research",
    "research:gate": "node scripts/research/gate.ts",
    "research:views": "node scripts/research/render-views.ts",
    "research:summary": "node scripts/research/build-summary.ts",
    "smoke": "node scripts/smoke.ts",
    "smoke:dev": "node scripts/smoke.ts dev",
    "check:pitch": "node scripts/check-pitch-browser.ts",
    "verify:setup": "node scripts/verify-setup.ts all",
    "prepare": "husky",
    "tokens": "node scripts/design/build-tokens.ts",
    "tokens:check": "node scripts/design/build-tokens.ts --check",
    "palette": "node scripts/design/check-palette.ts",
    "fonts": "node scripts/design/copy-fonts.ts",
    "review:screens": "node scripts/review-screens.ts"
  },
  "lint-staged": {
    "*.{ts,tsx,js,mjs,cjs,json,jsonc,css}": [
      "biome check --write --no-errors-on-unmatched"
    ]
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.1",
    "@biomejs/biome": "2.6.9",
    "@dagrejs/dagre": "3.1.4",
    "@fontsource-variable/geist-mono": "5.3.0",
    "@fontsource-variable/mona-sans": "5.3.0",
    "@mdx-js/mdx": "3.1.1",
    "@mdx-js/rollup": "3.1.1",
    "@playwright/test": "1.65.1",
    "@tailwindcss/vite": "4.3.5",
    "@types/d3-ease": "3.0.2",
    "@types/d3-interpolate": "3.0.4",
    "@types/mdx": "2.0.14",
    "@types/node": "26.6.11",
    "@types/react": "19.3.3",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "husky": "9.1.7",
    "lint-staged": "17.6.2",
    "remark-frontmatter": "5.0.0",
    "tailwindcss": "4.3.5",
    "typescript": "7.0.2",
    "vite": "8.4.0",
    "vitest": "5.1.2"
  },
  "dependencies": {
    "@base-ui/react": "1.9.0",
    "@dnd-kit/react": "0.5.3",
    "@mdx-js/react": "3.1.1",
    "d3-ease": "3.0.2",
    "d3-interpolate": "3.0.2",
    "motion": "14.14.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-router": "8.5.3",
    "zod": "4.6.7",
    "zustand": "5.1.0"
  }
}
